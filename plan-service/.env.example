# =============================================================================
# Plan Service — Environment Configuration
# =============================================================================
# Copy this file to .env and adjust values for your environment.

# Application
APP_NAME=plan-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://electridom:electridom@localhost:5432/electridom_plans
DATABASE_ECHO=false

# Redis (for Celery)
REDIS_URL=redis://localhost:6379/0

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# MinIO (S3-compatible storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=electridom
MINIO_SECRET_KEY=electridom123
MINIO_BUCKET=plans
MINIO_SECURE=false

# Processing
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_TYPES=pdf,dxf
PROCESSING_TIMEOUT_SECONDS=120

# AI/ML (optional — for fallback on complex plans)
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o
